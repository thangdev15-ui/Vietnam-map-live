# Để 0.0.0.0 khi chạy trên Render/Railway/Docker; local cũng chạy được.
HOST=0.0.0.0
PORT=3001
ADMIN_TOKEN=replace-with-at-least-24-random-characters
DATABASE_PATH=data/game.sqlite
# Tạo tại https://www.eulerstream.com rồi giữ khóa này ở máy chủ, không đưa lên frontend.
TIKTOK_SIGN_API_KEY=
# ElevenLabs: chọn giọng Việt trong dashboard, rồi đặt API key và Voice ID ở máy chủ.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
