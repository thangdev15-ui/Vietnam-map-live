# Để 0.0.0.0 khi chạy trên Render/Railway/Docker; local cũng chạy được.
HOST=0.0.0.0
PORT=3001
ADMIN_TOKEN=replace-with-at-least-24-random-characters
DATABASE_PATH=data/game.sqlite
# Community mặc định: để trống key, connector dùng free community signing.
# Chỉ đặt business + key Euler Business khi cần giới hạn cao hơn.
TIKTOK_SIGN_MODE=community
TIKTOK_SIGN_API_KEY=
# FPT.AI TTS: lấy API key tại console.fpt.ai, chỉ giữ ở máy chủ.
FPT_TTS_API_KEY=
FPT_TTS_VOICE=banmai
FPT_TTS_SPEED=0
