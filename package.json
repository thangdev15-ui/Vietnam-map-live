{
  "name": "vietnam-dai-chien",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k 'tsx watch apps/backend/src/index.ts' 'vite --host 0.0.0.0'",
    "build:frontend": "vite build",
    "build": "tsc --noEmit && vite build && tsup apps/backend/src/index.ts --format esm --out-dir dist/server --external tiktok-live-connector",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "lint": "eslint .",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "compression": "^1.8.2",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "node-edge-tts": "^1.2.12",
    "phaser": "^3.90.0",
    "polygon-clipping": "^0.15.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "tailwindcss": "^4.0.0",
    "tiktok-live-connector": "2.5.0",
    "vite": "^8.3.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
